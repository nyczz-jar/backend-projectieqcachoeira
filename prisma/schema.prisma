generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

model Event {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  location  String
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(uuid())
  description String
  timeAgo     String
  createdAt   DateTime @default(now())
}

model Member {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  role         String
  status       String          @default("Ativo")
  createdAt    DateTime        @default(now())
  socialTriages TriagemSocial[]
}

model Scale {
  id          String   @id @default(uuid())
  ministry    String
  date        DateTime
  volunteer   String
  createdAt   DateTime @default(now())
}

model Transacao {
  id        Int      @id @default(autoincrement())
  tipo      String
  descricao String
  categoria String
  valor     Float
  data      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([data])
}

model TriagemSocial {
  id                   Int      @id @default(autoincrement())
  membroId             String
  membro               Member   @relation(fields: [membroId], references: [id], onDelete: Restrict)
  dataTriagem          DateTime @default(now())
  demandas             String
  notas                String?
  statusEncaminhamento String   @default("Pendente")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([membroId])
  @@index([statusEncaminhamento])
  @@index([createdAt])
}

model CursoLocal {
  id              Int      @id @default(autoincrement())
  nome            String
  categoria       String?
  descricao       String
  dataInicio      DateTime?
  dataTermino     DateTime?
  statusAprovacao String   @default("Pendente")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([statusAprovacao, createdAt])
}

model VagaEmprego {
  id              Int      @id @default(autoincrement())
  titulo          String
  empresa         String?
  descricao       String
  requisitos      String
  dataPublicacao  DateTime @default(now())
  statusAprovacao String   @default("Pendente")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([statusAprovacao, dataPublicacao])
}